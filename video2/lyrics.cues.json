  {"start": 73.34, "end": 74.9, "text": "I bought a tiny planet from a guy named Steve,", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "planet", "line": 72},
  {"start": 74.9, "end": 76.78, "text": "He said, \u201cDon't feed it after Christmas Eve.\u201d", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "planet", "line": 73},
  {"start": 76.78, "end": 77.7, "text": "I fed it cheese.", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "planet", "line": 74},
  {"start": 77.7, "end": 78.44, "text": "It learned French.", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "planet", "line": 75},
  {"start": 78.44, "end": 79.98, "text": "Now Belgium wants it extradited.", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "planet", "line": 76},
  {"start": 79.98, "end": 81.12, "text": "My lawyer is a pigeon,", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "pigeon", "line": 78},
  {"start": 81.12, "end": 81.82, "text": "My doctor is a chair,", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "chair", "line": 79},
  {"start": 81.82, "end": 83.0, "text": "My landlord is an ancient god", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "god", "line": 80},
  {"start": 83.0, "end": 84.26, "text": "Who charges rent in hair.", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "god", "line": 81},
  {"start": 84.26, "end": 84.86, "text": "I asked the universe,", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "god", "line": 83},
  {"start": 84.86, "end": 86.32, "text": "\u201cWhat's the meaning of life?\u201d", "scene": "verse2", "section": "Verse 2", "tag": "08 / THE UNIVERSE HAS TERMS", "prop": "god", "line": 84},
