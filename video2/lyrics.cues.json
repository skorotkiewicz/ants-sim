  {"start": 25.92, "end": 26.9, "text": "I woke up at a quarter past banana,", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "clock", "line": 21},
  {"start": 26.9, "end": 28.98, "text": "Wearing seven shoes and somebody's pajama,", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "shoe", "line": 22},
  {"start": 28.98, "end": 30.24, "text": "My refrigerator said, \u201cWe need to talk,\u201d", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "fridge", "line": 23},
  {"start": 30.24, "end": 31.78, "text": "Then grew two legs and went out for a walk.", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "fridge", "line": 24},
  {"start": 31.78, "end": 33.64, "text": "My Wi-Fi joined a cult last night,", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "cult", "line": 26},
  {"start": 33.64, "end": 35.26, "text": "My cactus learned to copyright,", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "cactus", "line": 27},
  {"start": 35.26, "end": 36.88, "text": "There's a horse inside my Uber app,", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "horse", "line": 28},
  {"start": 36.88, "end": 38.36, "text": "And Grandma just invented trap.", "scene": "verse", "section": "Verse 1", "tag": "03 / HOUSEHOLD SYSTEM FAILURE", "prop": "grandma", "line": 29},
  {"start": 38.36, "end": 39.3, "text": "One, two\u2014", "scene": "count", "section": "Counting failure", "tag": "04 / BASIC MATH IS CANCELLED", "prop": "button", "line": 32, "number": "1 2"},
  {"start": 39.3, "end": 40.0, "text": "Wait, where's three?", "scene": "count", "section": "Counting failure", "tag": "04 / BASIC MATH IS CANCELLED", "prop": "button", "line": 33, "number": "3?"},
  {"start": 40.0, "end": 41.36, "text": "Four just filed for bankruptcy.", "scene": "count", "section": "Counting failure", "tag": "04 / BASIC MATH IS CANCELLED", "prop": "button", "line": 34, "number": "4"},
  {"start": 41.36, "end": 42.44, "text": "Five, six\u2014", "scene": "count", "section": "Counting failure", "tag": "04 / BASIC MATH IS CANCELLED", "prop": "button", "line": 36, "number": "5 6"},
  {"start": 42.44, "end": 43.18, "text": "LICK THE SKY!", "scene": "count", "section": "Counting failure", "tag": "04 / BASIC MATH IS CANCELLED", "prop": "button", "line": 37, "number": "?", "timing": "estimated: distorted or whispered vocal"},
